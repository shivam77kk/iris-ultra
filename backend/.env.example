# IRIS ULTRA Backend Environment Variables

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/iris-ultra

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Otari LLM Gateway Configuration
OTARI_API_KEY=your_otari_api_key_here
OTARI_BASE_URL=https://api.otari.ai/v1

# Smallest.ai Speech-to-Text & Text-to-Speech
SMALLEST_API_KEY=your_smallest_ai_api_key_here

# Budget Governance ($ USD per session)
SESSION_BUDGET=2.00

# Nodemailer / OTP verification (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="IRIS AI <no-reply@iris-ultra.ai>"
